# Copy to .env.local for local Convex dev (`npx convex dev` reads this).
# In production these are set via the Convex dashboard's environment variables,
# not this file — never commit real values.

# Convex deployment.
# CONVEX_DEPLOYMENT is written automatically by `npx convex dev` on first
# run/login — no need to set it by hand. CONVEX_URL / CONVEX_SITE_URL come
# from the deployment's dashboard (Settings > URL & Deploy Key) — the
# *_SITE_URL is the HTTP Actions URL Meta's webhook will point at (Phase 2).
CONVEX_DEPLOYMENT=
CONVEX_URL=
CONVEX_SITE_URL=

# WhatsApp Cloud API (Meta App Dashboard)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Claude parsing
ANTHROPIC_API_KEY=
